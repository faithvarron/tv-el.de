---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["logo-mark", className]}>
	<svg
		class="logo-icon"
		viewBox="0 0 64 64"
		role="img"
		aria-label="TV EL Logo: drei Equalizer-Balken in Orange"
		focusable="false"
	>
		<title>TV EL Logo</title>
		<defs>
			<linearGradient id="logo-bars" x1="0" y1="1" x2="1" y2="0">
				<stop offset="0" stop-color="#e0562b"></stop>
				<stop offset="1" stop-color="#ffb238"></stop>
			</linearGradient>
		</defs>
		<rect x="14" y="32" width="9" height="20" rx="4" fill="url(#logo-bars)"></rect>
		<rect x="27.5" y="18" width="9" height="34" rx="4" fill="url(#logo-bars)"></rect>
		<rect x="41" y="25" width="9" height="27" rx="4" fill="url(#logo-bars)"></rect>
	</svg>
	<span class="logo-text">TV EL</span>
</span>

<style>
	.logo-mark {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.logo-icon {
		width: 1.6rem;
		height: 1.6rem;
		flex: none;
	}

	.logo-text {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 1.75rem;
		letter-spacing: 0.06em;
		line-height: 1;
	}
</style>
