---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostGrid from '../components/PostGrid.astro';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [featured, ...rest] = posts;

// Deterministic pseudo-random bar heights/timings for the visualizer, so the
// build output is stable rather than reshuffling on every rebuild.
function seededRandom(seed: number) {
	const x = Math.sin(seed) * 10000;
	return x - Math.floor(x);
}

const BAR_COUNT = 56;
const bars = Array.from({ length: BAR_COUNT }, (_, i) => {
	const r1 = seededRandom(i * 12.9898);
	const r2 = seededRandom(i * 78.233 + 1);
	const r3 = seededRandom(i * 39.425 + 2);
	return {
		minHeight: Math.round(8 + r1 * 18),
		maxHeight: Math.round(45 + r2 * 45),
		duration: (0.9 + r3 * 1.3).toFixed(2),
		delay: (r1 * -2.4).toFixed(2),
	};
});
---

<BaseLayout
	title="TV EL – Musik verstehen, lernen und erleben"
	description="TV EL ist ein Musikmagazin mit Artikeln zu Musiktheorie, Musikgeschichte, Instrumenten, Produktion und der Musikindustrie."
	fullBleedHeader
>
	<section class="hero">
		<div class="hero-glow" aria-hidden="true"></div>

		<div class="visualizer" aria-hidden="true">
			{
				bars.map((bar) => (
					<span
						class="bar"
						style={`--min:${bar.minHeight}%; --max:${bar.maxHeight}%; --dur:${bar.duration}s; --delay:${bar.delay}s;`}
					/>
				))
			}
		</div>

		<div class="hero-inner">
			<p class="kicker">Musikmagazin</p>
			<h1>Musik verstehen,<br />lernen &amp; erleben</h1>
			<a class="cta" href={`/${featured.id}/`}>Neuesten Artikel lesen &rarr;</a>
		</div>
	</section>

	<div class="wrap">
		<div class="section-head">
			<h2>Neueste Artikel</h2>
		</div>

		<PostGrid posts={rest} />
	</div>
</BaseLayout>

<style>
	.hero {
		position: relative;
		z-index: 0;
		display: flex;
		align-items: flex-end;
		min-height: 78vh;
		padding: 0 1.25rem 4.5rem;
		background: linear-gradient(160deg, #1b120b 0%, #2a160c 45%, #0f0906 100%);
		overflow: hidden;
	}

	.hero-glow {
		position: absolute;
		inset: -10%;
		background:
			radial-gradient(45% 55% at 18% 8%, rgb(255 178 56 / 60%), transparent 60%),
			radial-gradient(55% 60% at 85% 95%, rgb(224 86 43 / 65%), transparent 65%);
		animation: glow-drift 14s ease-in-out infinite alternate;
	}

	@keyframes glow-drift {
		0% {
			transform: translate(0, 0) scale(1);
			opacity: 0.9;
		}
		100% {
			transform: translate(-2%, 2%) scale(1.08);
			opacity: 1;
		}
	}

	.hero::after {
		content: "";
		position: absolute;
		inset: 0;
		background: repeating-linear-gradient(
			115deg,
			rgb(255 255 255 / 4%) 0 2px,
			transparent 2px 6px
		);
		mix-blend-mode: overlay;
		z-index: 1;
	}

	.visualizer {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 62%;
		display: flex;
		align-items: flex-end;
		gap: clamp(2px, 0.6vw, 6px);
		padding: 0 1.25rem;
		z-index: 1;
		mask-image: linear-gradient(to top, black 0%, black 55%, transparent 100%);
		-webkit-mask-image: linear-gradient(to top, black 0%, black 55%, transparent 100%);
	}

	.bar {
		flex: 1 1 0;
		min-width: 2px;
		height: var(--min);
		border-radius: 3px 3px 0 0;
		background: linear-gradient(180deg, var(--accent-2) 0%, var(--accent) 100%);
		opacity: 0.55;
		animation: bar-bounce var(--dur) ease-in-out infinite alternate;
		animation-delay: var(--delay);
		transform-origin: bottom;
	}

	@keyframes bar-bounce {
		from {
			height: var(--min);
		}
		to {
			height: var(--max);
		}
	}

	.hero-inner {
		position: relative;
		z-index: 2;
		max-width: 920px;
		margin: 0 auto;
		width: 100%;
		color: #fff6ec;
	}

	.kicker {
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--accent-2);
		margin: 0 0 0.75rem;
	}

	.hero h1 {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		font-size: clamp(2.75rem, 8vw, 5.5rem);
		line-height: 0.98;
		letter-spacing: 0.01em;
		margin: 0 0 1.75rem;
		text-shadow: 0 2px 24px rgb(0 0 0 / 35%);
	}

	.cta {
		display: inline-block;
		color: #fff6ec;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
		border-bottom: 2px solid var(--accent-2);
		padding-bottom: 0.15rem;
	}

	.cta:hover {
		color: var(--accent-2);
	}

	.wrap {
		max-width: 920px;
		margin: 0 auto;
		padding: 3.5rem 1.25rem 4rem;
	}

	.section-head h2 {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		font-size: 1.75rem;
		margin: 0 0 2rem;
	}

	@media (max-width: 680px) {
		.hero {
			min-height: 60vh;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-glow,
		.bar {
			animation: none;
		}

		.bar {
			height: var(--max);
			opacity: 0.4;
		}
	}
</style>
